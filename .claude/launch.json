{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "paperclip",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "TMPDIR=/tmp pnpm dev"
      ],
      "port": 3108,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@paperclipai/ui",
        "exec",
        "storybook",
        "dev",
        "-p",
        "6016",
        "-c",
        "storybook/.storybook",
        "--no-open",
        "--ci"
      ],
      "port": 6016
    }
  ]
}
